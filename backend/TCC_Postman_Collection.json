{
  "info": {
    "name": "Saúde App TCC",
    "description": "Coleção de rotas para o TCC Gestão Diagnóstico Clínico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gerais",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Identidade",
      "item": [
        {
          "name": "Cadastrar Usuário",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cpf\": \"12345678901\",\n    \"nome_completo\": \"João da Silva\",\n    \"email\": \"joao@email.com\",\n    \"senha\": \"senha12345\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/usuarios",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Login (Gerar JWT)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cpf\": \"12345678901\",\n    \"senha\": \"senha12345\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Clínica (Tenant)",
      "item": [
        {
          "name": "Criar Instituição",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer "}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cnpj\": \"12345678901234\",\n    \"razao_social\": \"Clínica TCC\",\n    \"nome_fantasia\": \"TCC Saúde\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/tenants",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tenants"]
            }
          }
        }
      ]
    },
    {
      "name": "Diagnósticos e Prontuários",
      "item": [
        {
          "name": "Emitir Diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer "},
              {"key": "X-Tenant-ID", "value": "33333333-3333-3333-3333-333333333333"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paciente_id\": \"11111111-1111-1111-1111-111111111111\",\n    \"titulo\": \"Gripe Comum\",\n    \"descricao\": \"Repouso de 3 dias e hidratação.\",\n    \"codigo_cid\": \"J10\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/diagnosticos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["diagnosticos"]
            }
          }
        },
        {
          "name": "Listar Diagnósticos da Clínica",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer "},
              {"key": "X-Tenant-ID", "value": "33333333-3333-3333-3333-333333333333"}
            ],
            "url": {
              "raw": "http://localhost:3000/diagnosticos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["diagnosticos"]
            }
          }
        },
        {
          "name": "Histórico do Paciente",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer "},
              {"key": "X-Tenant-ID", "value": "33333333-3333-3333-3333-333333333333"}
            ],
            "url": {
              "raw": "http://localhost:3000/pacientes/11111111-1111-1111-1111-111111111111/diagnosticos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["pacientes", "11111111-1111-1111-1111-111111111111", "diagnosticos"]
            }
          }
        },
        {
          "name": "Cancelar Diagnóstico",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer "},
              {"key": "X-Tenant-ID", "value": "33333333-3333-3333-3333-333333333333"}
            ],
            "url": {
              "raw": "http://localhost:3000/diagnosticos/22222222-2222-2222-2222-222222222222/cancelar",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["diagnosticos", "22222222-2222-2222-2222-222222222222", "cancelar"]
            }
          }
        }
      ]
    }
  ]
}
